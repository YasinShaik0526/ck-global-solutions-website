# Configure these in Netlify: Site configuration > Environment variables.
# Never commit the real access token.
WHATSAPP_ACCESS_TOKEN=replace_with_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_RECIPIENT_NUMBER=919985727179

# Recommended for notifications outside the 24-hour conversation window.
# Create an approved template with three body variables: name, email, message.
WHATSAPP_TEMPLATE_NAME=new_website_enquiry
WHATSAPP_TEMPLATE_LANGUAGE=en_US
